# Python caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Local AI / editor settings
.claude/
.codex/
.vscode/
.idea/

# Local Netlify metadata / CLI runtime (generated, do not commit)
.netlify/

# Generated output and preview artifacts
output/
sns/
deploy_public/
deploy_public_*/
reports/codex_reports/

# Operational inputs that should usually stay local
input/*.xlsx
input/*.xls
input/*.csv
!input/image_map.csv

# Logs and OS cruft
*.log
nul
.DS_Store
Thumbs.db
*.lnk
*.tmp

# --- 2026-06-19 audit additions (heavy/generated/runtime; prefer ignore over delete) ---
# Generated demo output + review/deploy artifacts (large; reproducible)
generated_demos/
deploy_*_review_*/
# Reports tree (operational artifacts + playwright screenshots; source reports live in docs/)
reports/
# Bulk source media / build / test artifacts
input/images/
screenshots/
qa_artifacts/
playwright-report/
test-results/
dist/
build/
coverage/
node_modules/
# Large doc screenshot (keep docs/*.md tracked)
docs/*.png
# Env / secrets (never commit)
.env
.env.*
*.key
*.pem
*.token

# Salon LP template sample image assets (~16M; keep template source HTML/JSON/PY/MD, drop sample images)
templates/salon_editorial_variant/assets/
